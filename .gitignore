# template/ de cada materia es su propio repo git, no se anida acá
materias/*/template/

# repos clonados de cada grupo — son sus propios repos, no se versionan acá
materias/*/grupos/

# tooling local (los comandos personalizados en .claude/commands/ sí se versionan)
.idea/
.claude/settings.local.json

# n8n: datos/credenciales locales (infra/n8n/.gitignore ya cubre .env y el json de OAuth)
infra/n8n/.env
infra/n8n/google-oauth-client.json

# python
__pycache__/
*.pyc
