    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Un solo pedido a la API con todos los mails: cuerpo en texto y los .txt adjuntos.\nconst items = $input.all();\nconst mensajes = [];\nfor (let i = 0; i < items.length; i++) {\n  const j = items[i].json;\n  if (!j.id) continue; // sin mails: Gmail devuelve un item vacío\n  const adjuntos = [];\n  for (const [k, b] of Object.entries(items[i].binary || {})) {\n    if (/\\.txt$/i.test(b.fileName || '') || (b.mimeType || '').startsWith('text/')) {\n      adjuntos.push((await this.helpers.getBinaryDataBuffer(i, k)).toString('utf8'));\n    }\n  }\n  mensajes.push({ id: j.id, de: (j.from && j.from.text) || '', asunto: j.subject || '', texto: j.text || '', adjuntos });\n}\nreturn [{ json: { mensajes } }];"
      },
