    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const materia = $('Datos de la devolución').item.json.materia;\nconst grupoId = $('Datos de la devolución').item.json.grupo_id;\nconst fecha = $('Datos de la devolución').item.json.fecha;\nconst grupos = $input.all()[0].json.parsed.grupos;\nconst found = grupos.find(g => g.id === grupoId);\nif (!found) {\n  throw new Error(`Grupo '${grupoId}' no está en materias/${materia}/grupos.json`);\n}\nif (!found.email) {\n  throw new Error(`Grupo '${grupoId}' no tiene email cargado en grupos.json`);\n}\nif (!found.repo) {\n  throw new Error(`Grupo '${grupoId}' no tiene repo cargado en grupos.json`);\n}\nconst repoUrl = found.repo.replace(/\\.git$/, '');\nconst feedbackUrl = `${repoUrl}/blob/main/feedback/${fecha}.md`;\nreturn [{ json: { materia: materia, grupo_id: grupoId, fecha: fecha, email_destino: found.email, feedback_url: feedbackUrl } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
