        "message": "=Hola,\n\nLa devolución del {{ $('Buscar datos del grupo').item.json.grupo_id }} ya está disponible.\n\nPodés verla acá: {{ $('Buscar datos del grupo').item.json.feedback_url }}\n\nSaludos,\nSistema EIDAS",
