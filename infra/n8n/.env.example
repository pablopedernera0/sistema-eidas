# Copiar a .env y completar antes de levantar el contenedor.
# Para uso local, los valores por defecto de host/protocolo/webhook alcanzan.
# Al migrar al Linode, cambiar N8N_HOST, N8N_PROTOCOL=https y WEBHOOK_URL al dominio real.

N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar-esta-contraseña

N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
